export buttonDefaultPrimaryDefault = frame {
  title: "button / Size=default, variant=primary, :state=default",
  left: 0px,
  top: 0px,
  layout: {
    justify-content: .center,
    align-items: .center,
    item-gap: 10px,
    include-borders: .true
  },
  fill: colorTokens.colors.red-50,
  border: colorTokens.colors.red-50,
  corner-radius: 4px,
  padding: [12px, 24px],
  children: [overlay, iconAdd, button, adsClick],

  overlay = frame {
    left: 0px,
    top: 0px,
    width: 328px,
    height: 42px,
    display: .none,
    ignore-stack: .true,
    fill: rgb(0%, 0%, 0%, 10.1961%),
    corner-radius: 10px
  }

  iconAdd = asset {
    width: 16px,
    height: 16px,
    fill: colorTokens.colors.neutral-00,
    contents: iconIconAdd
  }

  button = text {
    fill: colorTokens.colors.neutral-00,
    contents: "BUTTON",
    font-size: 14,
    font-family: "DIN Next LT Pro",
    font-style: "Medium",
    line-height: 1.14,
    align: .center
  }

  adsClick = asset {
    width: 16px,
    height: 16px,
    fill: colorTokens.colors.neutral-00,
    contents: iconAdsClickOutlined
  }
}

