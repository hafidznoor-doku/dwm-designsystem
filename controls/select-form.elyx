  biArrowRightCircle = asset {
    width: 12px,
    height: 12px,
    fill: rgb(30.1961%, 30.1961%, 30.1961%),
    contents: iconBiArrowRightCircle
  }

  contentSlotComponent = frame {
    width: 1px,
    height: 100%,
    display: .none,
    layout: {
      direction: .column,
      justify-content: .center,
      align-items: .center,
      item-gap: 4px
    },
    fill: colorTokens.colors.cyan-05,
    padding: [4px, 16px],
    children: [iconFontAwesomeFreeRegularLLightbulb, swapComponentHere],

    iconFontAwesomeFreeRegularLLightbulb = asset {
      width: 10px,
      height: 10px,
      fill: .black,
      contents: iconIconFontAwesomeFreeRegularLLightbulb
    }

    swapComponentHere = text {
      width: 100%,
      fill: .black,
      contents: "Swap component here",
      font-size: 8,
      font-family: "DIN Next LT Pro",
      font-style: "Regular",
      line-height: 1.5,
      align: .center
    }
  }

  textLayer = text {
    fill: rgb(30.1961%, 30.1961%, 30.1961%),
    contents: "Dropdown menu",
    font-size: 14,
    font-family: "DIN Next LT Pro",
    font-style: "Regular",
    line-height: 1.429
  }

  biArrowRightCircle2 = asset {
    width: 12px,
    height: 12px,
    fill: rgb(30.1961%, 30.1961%, 30.1961%),
    contents: iconBiArrowRightCircle
  }
}
