import "tokens/colors.elyx" as colorTokens
import "resources/assets/icons/dw-icon-akun-smart-login-outline.svg" as iconDwIconAkunSmartLoginOutline

export toggleFalseFalse = frame {
  title: "Toggle / active=false, ?disabled=false",
  left: 0px,
  top: 0px,
  width: 37.78px,
  height: 20px,
  children: [container, trigger],

  container = shape {
    left: 0px,
    top: 0px,
    width: 37.78px,
    height: 20px,
    fill: colorTokens.colors.neutral-20,
    type: .rect,
    corner-radius: 42px
  }

  trigger = shape {
    left: 3px,
    top: 2px,
    width: 16px,
    height: 16px,
    fill: colorTokens.colors.neutral-00,
    shadow: {
      drop-shadow: {
        color: rgb(0%, 0%, 0%, 14.9%),
        offset: point(3px, 3px),
        blur-radius: 3px,
        spread: -3px
      }
    },
    type: .ellipse
  }
}

