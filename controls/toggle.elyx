export toggleList = frame {
  title: "_toggle-list",
  left: 0px,
  top: 352px,
  layout: {item-gap: 16px},
  overflow: .visible,
  children: [frame850, toggle],

  frame850 = frame {
    width: 290.22px,
    layout: {align-items: .center, item-gap: 24px},
    overflow: .visible,
    children: [dwIcon, ubahProfil],

    dwIcon = asset {
      width: 24px,
      height: 24px,
      fill: rgb(30.1961%, 30.1961%, 30.1961%),
      contents: iconDwIconAkunSmartLoginOutline
    }

    ubahProfil = text {
      fill: rgb(30.1961%, 30.1961%, 30.1961%),
      contents: "Smart Login",
      font-size: 14,
      font-family: "DIN Next LT Pro",
      font-style: "Medium",
      line-height: 1.14
    }
  }

  toggle = frame : toggleTrueFalse {}
}
