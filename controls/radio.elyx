export radioButtonDefaultLarge = frame {
  title: "Radio Button / :state=default, Size=large",
  left: 0px,
  top: 0px,
  layout: {item-gap: 12px},
  overflow: .visible,
  children: [radio, textLayer],

  radio = asset {
    width: 25px,
    height: 25px,
    contents: iconRadio
  }

  textLayer = frame {
    layout: {direction: .column},
    overflow: .visible,
    padding: [4px, 0px],
    children: [textLayer, subText],

    textLayer = text {
      fill: colorTokens.colors.neutral-80,
      contents: "Laki-laki",
      font-size: 16,
      font-family: "DIN Next LT Pro",
      font-style: "Medium"
    }

    subText = text {
      fill: colorTokens.colors.neutral-80,
      contents: "Pilih jika laki laki",
      font-size: 14,
      font-family: "DIN Next LT Pro",
      font-style: "Regular",
      line-height: 1.14
    }
  }
}

