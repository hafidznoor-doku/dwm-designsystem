    kodeVerifikasiYang = text {
      width: 341px,
      fill: colorTokens.colors.neutral-40,
      contents: "Kode Verifikasi telah dikirim via SMS ke: 08123****898",
      font-size: 16,
      font-family: "DIN Next LT Pro",
      font-style: "Regular",
      line-height: 1.5,
      align: .center
    }
  }

  pinInput = frame : inputFormLib.pinInput {
    width: 100%,
    layout.align-items: .center,
    layout.direction: .row,
    layout.item-gap: 16px,
    layout.justify-content: .center
  }

  frame33551 = frame {
    width: 100%,
    layout: {direction: .column, item-gap: 8px},
    overflow: .visible,
    children: [verificationChanceInfo, mohonTungguDalam1],

    verificationChanceInfo = frame : verificationChanceInfoDefault {}

    mohonTungguDalam1 = text {
      width: 100%,
      fill: colorTokens.colors.green-50,
      contents: "Atau kirim via WhatsApp",
      font-size: 14,
      font-family: "DIN Next LT Pro",
      font-style: "Regular",
      line-height: 1.14,
      align: .center
    }
  }
}

