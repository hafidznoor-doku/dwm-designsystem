export verificationCodeSmsDefault = frame {
  title: "Verification Code / phase=sms, type=default",
  left: 0px,
  top: 0px,
  width: 360px,
  layout: {direction: .column, align-items: .center, item-gap: 24px},
  overflow: .visible,
  padding: [0px, 16px],
  children: [row, pinInput, frame33551],

  row = frame {
    width: 100%,
    layout: {direction: .column, align-items: .center, item-gap: 8px},
    children: [masukanKodeVerifik, kodeVerifikasiYang],

