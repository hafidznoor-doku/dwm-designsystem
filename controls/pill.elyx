import "tokens/colors.elyx" as colorTokens
import "resources/assets/icons/pan-tool-outlined.svg" as iconPanToolOutlined
import "resources/assets/icons/payment-outlined.svg" as iconPaymentOutlined

export switch = frame {
  title: "switch",
  left: 0px,
  top: 0px,
  layout: {direction: .row},
  overflow: .visible,
  children: [masterPill, masterPill2],

  masterPill = frame {
    layout: {justify-content: .center, align-items: .center, item-gap: 10px},
    fill: colorTokens.colors.neutral-20,
    corner-radius: 40px,
    overflow: .visible,
    padding: [6px, 8px],
    children: [panTool, qris],

    panTool = asset {
      width: 12px,
      height: 12px,
      fill: colorTokens.colors.red-50,
      contents: iconPanToolOutlined
    }

    qris = text {
      fill: colorTokens.colors.red-50,
      contents: "QRIS",
      font-size: 12,
      font-family: "DIN Next LT Pro",
      font-style: "Medium",
      align: .center
    }
  }

  masterPill2 = frame {
    layout: {justify-content: .center, align-items: .center, item-gap: 4px},
    corner-radius: 40px,
    overflow: .visible,
    padding: [6px, 8px],
    children: [payment, qris],

    payment = asset {
      width: 12px,
      height: 12px,
      fill: colorTokens.colors.neutral-50,
      contents: iconPaymentOutlined
    }

    qris = text {
      fill: colorTokens.colors.neutral-50,
      contents: "QRIS",
      font-size: 12,
      font-family: "DIN Next LT Pro",
      font-style: "Medium",
      align: .center
    }
  }
}

