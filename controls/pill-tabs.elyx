import "controls/pill.elyx" as pillLib

export pillTabs2Tabs = frame {
  title: "Pill Tabs / Counts=2 tabs",
  left: 0px,
  top: 0px,
  layout: {align-items: .center, item-gap: 16px},
  overflow: .visible,
  children: [pill, pill2],

  pill = frame : pillLib.pillSelectedMedium {
    creditCard {
      display: .none
    }

    qris {
      contents: "Tab 1"
    }
  }

  pill2 = frame : pillLib.pillDefaultMedium {
    creditCard {
      display: .none
    }

    qris {
      contents: "Tab 2"
    }
  }
}

