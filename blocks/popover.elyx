        button2 = frame : buttonLib.buttonSmallSecondaryDefault {
          iconAdd {
            display: .none
          }

          adsClick {
            display: .none
          }
        }
      }
    }
  }

  frame52 = asset {
    width: 300px,
    height: 6px,
    fill: colorTokens.colors.neutral-00,
    contents: iconFrame527
  }
}

