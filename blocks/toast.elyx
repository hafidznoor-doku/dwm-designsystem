import "tokens/colors.elyx" as colorTokens
import "resources/assets/icons/check-circle-24px.svg" as iconCheckCircle24px
import "resources/assets/icons/icon-font-awesome-free-solid-c-check-circle.svg" as iconIconFontAwesomeFreeSolidCCheckCircle
import "resources/assets/icons/auto-added-frame.svg" as iconAutoAddedFrame
import "resources/assets/icons/icon-font-awesome-free-solid-e-exclamation-circle.svg" as iconIconFontAwesomeFreeSolidEExclamationCircle
import "resources/assets/icons/cancel-16px-2.svg" as iconCancel16px2
import "resources/assets/icons/icon-font-awesome-free-solid-t-times-circle.svg" as iconIconFontAwesomeFreeSolidTTimesCircle
import "resources/assets/icons/help-24px-2.svg" as iconHelp24px2
import "resources/assets/icons/icon-font-awesome-free-solid-q-question-circle.svg" as iconIconFontAwesomeFreeSolidQQuestionCircle

export toastSuccess = frame {
  title: "Toast / State=Success",
  left: 0px,
  top: 0px,
  width: 384px,
  layout: {direction: .column, item-gap: 16px},
  fill: colorTokens.colors.green-10,
  shadow: [
    {
      drop-shadow: {
        color: rgb(6.27%, 9.41%, 15.6863%, 3.1373%),
        offset: point(0px, 8px),
        blur-radius: 8px,
        spread: -4px
      }
    },
    {
      drop-shadow: {
        color: rgb(6.27%, 9.41%, 15.6863%, 7.84%),
        offset: point(0px, 20px),
        blur-radius: 24px,
        spread: -4px
      }
    }
  ],
  corner-radius: 4px,
  padding: 16px,
  children: container,

  container = frame {
    width: 100%,
    layout: {align-items: .center, item-gap: 8px},
    children: [
      checkCircle24px,
      iconFontAwesomeFreeSolidCCheckCircle,
      successAlertHereSYouCanSeeASuccessAlert
    ],

    checkCircle24px = asset {
      width: 16px,
      height: 16px,
      display: .none,
      fill: colorTokens.colors.green-80,
      contents: iconCheckCircle24px
    }

    iconFontAwesomeFreeSolidCCheckCircle = asset {
      width: 16px,
      height: 16px,
      fill: rgb(0%, 50.98%, 49.0196%),
      contents: iconIconFontAwesomeFreeSolidCCheckCircle
    }

    successAlertHereSYouCanSeeASuccessAlert = text {
      width: 328px,
      fill: colorTokens.colors.green-80,
      subrange: {
        range: [13, 50],
        font-family: "DIN Next LT Pro",
        font-style: "Regular"
      },
      contents: "Success Alert - Here's you can see a success alert",
      font-size: 14,
      font-family: "DIN Next LT Pro",
      font-style: "Medium",
      line-height: 1.14
    }
  }
}

