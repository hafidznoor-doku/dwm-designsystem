export alertSuccess = frame {
  title: "Alert / Property 1=Success",
  left: 0px,
  top: 272px,
  width: 379px,
  layout: {direction: .column, item-gap: 16px},
  fill: colorTokens.colors.green-05,
  border: colorTokens.colors.green-30,
  corner-radius: 4px,
  padding: 16px,
  children: container,

  container = frame {
    width: 100%,
    layout: {align-items: .center, item-gap: 8px},
    children: [
      iconFontAwesomeFreeSolidCCheckCircle,
      iconFontAwesomeFreeSolidCCheckCircle2,
      successAlertHereSYouCanSeeASuccessAlert
    ],

    iconFontAwesomeFreeSolidCCheckCircle = asset {
      width: 16px,
      height: 16px,
      display: .none,
      fill: colorTokens.colors.green-80,
      contents: iconIconFontAwesomeFreeSolidCCheckCircle
    }

    iconFontAwesomeFreeSolidCCheckCircle2 = asset {
      width: 16px,
      height: 16px,
      fill: rgb(0%, 50.98%, 49.0196%),
      contents: iconIconFontAwesomeFreeSolidCCheckCircle
    }

    successAlertHereSYouCanSeeASuccessAlert = text {
      width: 323px,
      fill: rgb(40%, 40%, 40%),
      subrange: {
        range: [13, 50],
        font-family: "DIN Next LT Pro",
        font-style: "Regular"
      },
      contents: "Success Alert - Here's you can see a success alert",
      font-size: 14,
      font-family: "DIN Next LT Pro",
      font-style: "Medium",
      line-height: 1.14
    }
  }
}

