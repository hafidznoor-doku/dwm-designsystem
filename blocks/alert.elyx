export oldAlertDefault = frame {
  title: "_old-alert / color=Default",
  left: 0px,
  top: 0px,
  width: 328px,
  layout: {align-items: .center, item-gap: 10px},
  fill: colorTokens.colors.yellow-60,
  corner-radius: 8px,
  padding: [12px, 16px],
  children: [group12, highlightOff],

  group12 = frame {
    width: 262px,
    layout: {align-items: .center, item-gap: 16px},
    overflow: .visible,
    children: [priorityHigh, akunKamuBelumTerv],

    priorityHigh = asset {
      width: 16px,
      height: 16px,
      fill: colorTokens.colors.neutral-00,
      contents: iconPriorityHighOutlined
    }

    akunKamuBelumTerv = text {
      width: 230px,
      fill: colorTokens.colors.neutral-00,
      contents: "Akun kamu belum terverifikasi",
      font-size: 13,
      font-family: "DIN Next LT Pro",
      font-style: "Medium"
    }
  }

  highlightOff = asset {
    width: 24px,
    height: 24px,
    fill: colorTokens.colors.neutral-00,
    contents: iconHighlightOffOutlined
  }
}

