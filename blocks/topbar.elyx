import "resources/assets/icons/highlight-off-round.svg" as iconHighlightOffRound
import "resources/assets/icons/line-5.svg" as iconLine5

export topbarDefault = frame {
  title: "Topbar / variant=default",
  left: 0px,
  top: 0px,
  width: 312px,
  height: 55px,
  layout: {align-items: .center, item-gap: 10px},
  fill: colorTokens.colors.neutral-00,
  padding: [6px, 16px],
  children: [row, moreIcon],

  row = frame {
    width: 194px,
    layout: {align-items: .center, item-gap: 10px},
    overflow: .visible,
    children: [arrowBack, header],

    arrowBack = asset {
      width: 20px,
      height: 20px,
      fill: colorTokens.colors.neutral-80,
      contents: iconArrowBackRound
    }

    header = text {
      fill: colorTokens.colors.red-50,
      contents: "Header",
      font-size: 16,
      font-family: "DIN Next LT Pro",
      font-style: "Medium",
      line-height: 1.5
    }
  }

  moreIcon = asset {
    width: 76px,
    height: 20px,
    fill: colorTokens.colors.neutral-80,
    contents: iconMoreIcon
  }
}

