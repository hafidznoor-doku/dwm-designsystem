export topbarSearch = frame {
  title: "Topbar / variant=search",
  left: 0px,
  top: 206px,
  width: 312px,
  height: 55px,
  layout: {align-items: .center, item-gap: 10px},
  fill: colorTokens.colors.neutral-00,
  padding: [6px, 16px],
  children: [arrowBack, row, selesai],

  arrowBack = asset {
    width: 20px,
    height: 20px,
    fill: colorTokens.colors.neutral-80,
    contents: iconArrowBackRound
  }

  row = frame {
    width: 191px,
    layout: {direction: .column, justify-content: .center, item-gap: 2px},
    overflow: .visible,
    children: [frame1, line],

    frame1 = frame {
      width: 100%,
      layout: {align-items: .center, item-gap: 4px},
      overflow: .visible,
