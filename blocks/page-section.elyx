      font-family: "DIN Next LT Pro",
      font-style: "Regular",
      line-height: 1.429,
      align: .center
    }

    choice = frame {
      layout: {item-gap: 24px},
      overflow: .visible,
      children: [bad, good],

      bad = frame {
        layout: {align-items: .center},
        overflow: .visible,
        children: [frame871, button],

        frame871 = frame {
          width: 34px,
          height: 34px,
          overflow: .visible,
          children: [ellipse3, intersect, frame872],

          ellipse3 = shape {
            left: 0px,
            top: 0px,
            width: 34px,
            height: 34px,
            fill: colorTokens.colors.green-10,
