export sectionFeedback = frame {
  title: "Section/Feedback",
  left: 0px,
  top: 348px,
  width: 360px,
  layout: {direction: .column, item-gap: 16px},
  overflow: .visible,
  padding: 16px,
  children: ratingFrame,

  ratingFrame = frame {
    width: 100%,
    layout: {direction: .column, align-items: .center, item-gap: 12px},
    fill: colorTokens.colors.neutral-00,
    corner-radius: 8px,
    overflow: .visible,
    padding: 16px,
    children: [apakahKamuSukaDenganLayananDoku, choice],

    apakahKamuSukaDenganLayananDoku = text {
      fill: colorTokens.colors.neutral-80,
