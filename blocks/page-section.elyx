          }

          intersect = shape {
            left: 0.92px,
            top: 0px,
            width: 33.08px,
            height: 34px,
            fill: {image: {ref: image14989a8d8b1d32dc, sizing: .stretch}},
            type: .ellipse
          }

          frame872 = frame {
            left: -7px,
            top: -7px,
            width: 48.53px,
            height: 48.53px,
            overflow: .visible,
            children: [ellipse4, intersect],

            ellipse4 = shape {
              left: 0px,
              top: 0px,
              width: 34.31px,
              height: 34.31px,
              transform: [-0.7071, 0.7071, 24.26, -0.7071, -0.7071, 48.5277],
              fill: colorTokens.colors.red-10,
              type: .ellipse
            }

            intersect = shape {
              left: 0px,
              top: 0px,
              width: 33.39px,
              height: 34.31px,
              transform: [-0.7071, 0.7071, 23.608, -0.7071, -0.7071, 47.87],
              fill: {image: {ref: image14989a8d8b1d32dc, sizing: .stretch}},
              type: .ellipse
            }
          }
        }

        button = frame {
          height: 100%,
          display: .none,
          layout: {
            justify-content: .center,
            align-items: .center,
            item-gap: 4px
          },
          corner-radius: 4px,
          overflow: .visible,
          padding: [8px, 16px],
          children: myButton,

          myButton = text {
            fill: colorTokens.colors.red-50,
            contents: "Tidak Terlalu",
            font-size: 12,
            font-family: "DIN Next LT Pro",
            font-style: "Medium",
            line-height: 1,
            align: .center
          }
        }
      }

      good = frame {
        layout: {align-items: .center, item-gap: 8px},
        overflow: .visible,
        children: [frame871, button],

        frame871 = frame {
          width: 34px,
          height: 34px,
          overflow: .visible,
          children: [ellipse3, intersect],

          ellipse3 = shape {
            left: 0px,
            top: 0px,
