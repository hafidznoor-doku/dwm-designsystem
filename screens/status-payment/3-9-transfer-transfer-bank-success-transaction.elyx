        layout: {direction: .column, align-items: .center, item-gap: 10px},
        fill: colorTokens.colors.neutral-background,
        overflow: .visible,
        padding: 14px,
        children: ratingFrame,

        ratingFrame = frame {
          width: 336px,
          layout: {direction: .column, align-items: .center, item-gap: 12px},
          fill: colorTokens.colors.neutral-00,
          corner-radius: 8px,
          overflow: .visible,
          padding: 16px,
          children: [apakahKamuSukaDenganLayananDoku, frame875],

          apakahKamuSukaDenganLayananDoku = text {
            fill: rgb(30.1961%, 30.1961%, 30.1961%),
            contents: "Apakah kamu suka dengan layanan DOKU?",
            font-size: 14,
            font-family: "DIN Next LT Pro",
            font-style: "Regular",
            line-height: 1.429,
            align: .center
          }

          frame875 = frame {
            layout: {item-gap: 24px},
            overflow: .visible,
            children: [frame874, frame873],

            frame874 = frame {
              layout: {align-items: .center},
              overflow: .visible,
              children: [frame871, button],

              frame871 = frame {
                width: 34px,
                height: 34px,
                overflow: .visible,
                children: [ellipse3, intersect, frame872],

                ellipse3 = shape {
                  left: 0px,
                  top: 0px,
                  width: 34px,
                  height: 34px,
                  fill: colorTokens.colors.green-10,
                  type: .ellipse
                }

                intersect = shape {
                  left: 0.92px,
                  top: 0px,
                  width: 33.08px,
                  height: 34px,
                  fill: {image: {ref: image14989a8d8b1d32dc, sizing: .stretch}},
                  type: .ellipse
                }

                frame872 = frame {
                  left: -7px,
                  top: -7px,
                  width: 48.53px,
                  height: 48.53px,
                  overflow: .visible,
                  children: [ellipse4, intersect],

                  ellipse4 = shape {
                    left: 0px,
                    top: 0px,
                    width: 34.31px,
                    height: 34.31px,
                    transform: [
                      -0.7071,
                      0.7071,
                      24.26,
                      -0.7071,
                      -0.7071,
                      48.5277
                    ],
                    fill: colorTokens.colors.red-10,
                    type: .ellipse
                  }

                  intersect = shape {
                    left: 0px,
                    top: 0px,
                    width: 33.39px,
                    height: 34.31px,
                    transform: [
                      -0.7071,
                      0.7071,
                      23.608,
                      -0.7071,
                      -0.7071,
                      47.87
                    ],
                    fill: {
                      image: {ref: image14989a8d8b1d32dc, sizing: .stretch}
                    },
                    type: .ellipse
                  }
                }
              }

              button = frame {
                height: 100%,
                display: .none,
                layout: {
                  justify-content: .center,
                  align-items: .center,
                  item-gap: 4px
                },
                corner-radius: 4px,
                overflow: .visible,
                padding: [8px, 16px],
                children: myButton,

                myButton = text {
                  fill: colorTokens.colors.red-60,
                  contents: "Tidak Terlalu",
                  font-size: 12,
                  font-family: "DIN Next LT Pro",
                  font-style: "Medium",
                  line-height: 1,
                  align: .center
                }
              }
            }

            frame873 = frame {
              layout: {align-items: .center, item-gap: 8px},
              overflow: .visible,
              children: [frame871, button],

              frame871 = frame {
                width: 34px,
                height: 34px,
                overflow: .visible,
                children: [ellipse3, intersect],

                ellipse3 = shape {
                  left: 0px,
                  top: 0px,
                  width: 34px,
                  height: 34px,
                  fill: colorTokens.colors.green-10,
                  type: .ellipse
                }

                intersect = shape {
                  left: 0.92px,
                  top: 0px,
                  width: 33.08px,
                  height: 34px,
                  fill: {image: {ref: image14989a8d8b1d32dc, sizing: .stretch}},
                  type: .ellipse
                }
              }

              button = frame {
                height: 100%,
                display: .none,
                layout: {
                  justify-content: .center,
                  align-items: .center,
                  item-gap: 4px
                },
                fill: colorTokens.colors.red-50,
                corner-radius: 4px,
                overflow: .visible,
                padding: [8px, 16px],
                children: myButton,

                myButton = text {
                  fill: colorTokens.colors.neutral-00,
                  contents: "Ya, Suka!",
                  font-size: 12,
                  font-family: "DIN Next LT Pro",
                  font-style: "Medium",
                  line-height: 1,
                  align: .center
                }
              }
            }
          }
        }
      }
    }
  }
}
