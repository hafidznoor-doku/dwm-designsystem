                align-items: .center,
                item-gap: 4px
              },
              fill: colorTokens.colors.red-50,
              border: colorTokens.colors.red-50,
              corner-radius: 4px,
              overflow: .visible,
              padding: [8px, 16px],
              children: myButton,

              myButton = text {
                fill: colorTokens.colors.neutral-00,
                contents: "Ya, Suka!",
                font-size: 12,
                font-family: "DIN Next LT Pro",
                font-style: "Medium",
                line-height: 1,
                align: .center
              }
            }
          }
        }
      }
    }

    frame738 = frame {
      width: 316px,
      display: .none,
      layout: {
        justify-content: .space-between,
        align-items: .center,
        item-gap: 128px
      },
      overflow: .visible,
      children: [frame737, chevronRight],

      frame737 = frame {
        layout: {direction: .column},
        overflow: .visible,
        children: [butuhBantuan, kunjungiHalamanBantuan],

        butuhBantuan = text {
          fill: rgb(20%, 20%, 20%),
          contents: "Butuh Bantuan?",
          font-size: 16,
          font-family: "DIN Next LT Pro",
          font-style: "Medium",
          line-height: 1.5,
          align: .center
        }

        kunjungiHalamanBantuan = text {
          fill: rgb(30.1961%, 30.1961%, 30.1961%),
          contents: "Kunjungi halaman bantuan",
          font-size: 14,
          font-family: "DIN Next LT Pro",
          font-style: "Regular",
          line-height: 1.429,
          align: .center
        }
      }

      chevronRight = asset {
        width: 24px,
        height: 24px,
        fill: rgb(30.1961%, 30.1961%, 30.1961%),
        contents: iconChevronRight3
      }
    }
  }
}
